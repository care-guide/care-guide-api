# Copy this file to `.env` and adjust values for your local setup.
# `.env` is read by docker-compose to substitute ${VAR} in docker-compose.yml.
# It is gitignored — never commit real secrets.

# --- Application database ---
# DB_HOST/DB_PORT are how the API reaches Postgres over the docker network
# (service name + internal port), not the host-exposed port.
DB_HOST=db
DB_PORT=5432
DB_NAME=careguide
DB_USER=careguide
DB_PASSWORD=change_me
# Host port exposed for the app database (connect from your machine here).
DB_EXTERNAL_PORT=5434

# --- Test database ---
TEST_DB_NAME=careguide_tests
TEST_DB_USER=careguide
TEST_DB_PASSWORD=change_me
# Host port exposed for the test database.
TEST_DB_EXTERNAL_PORT=5435
