# Copy this file to `.env` and adjust values for your local setup.
# `.env` is read by docker-compose to substitute ${VAR} in docker-compose.yml.
# It is gitignored — never commit real secrets.

# Flutter Web frontend. Keep FRONTEND_ORIGIN aligned with FRONTEND_PORT.
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_API_URL=http://localhost:8080/api/v1
FRONTEND_API_TIMEOUT_MS=15000

DB_HOST=db
DB_PORT=5432
DB_NAME=careguide
DB_USER=careguide
DB_PASSWORD=change_me
DB_EXTERNAL_PORT=5434

TEST_DB_NAME=careguide_tests
TEST_DB_USER=careguide
TEST_DB_PASSWORD=change_me
TEST_DB_EXTERNAL_PORT=5435

STORAGE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_R2_ACCOUNT_ID=your-account-id
STORAGE_R2_BUCKET=care-guide-private
STORAGE_R2_ACCESS_KEY=change_me
STORAGE_R2_SECRET_KEY=change_me
